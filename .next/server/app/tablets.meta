{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/tablets/layout,_N_T_/tablets/page,_N_T_/tablets"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/tablets/__PAGE__",
    "/tablets",
    "/_index",
    "/_head"
  ]
}