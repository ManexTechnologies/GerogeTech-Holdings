{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/laptops/layout,_N_T_/laptops/page,_N_T_/laptops"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/laptops/__PAGE__",
    "/laptops",
    "/_index",
    "/_head"
  ]
}